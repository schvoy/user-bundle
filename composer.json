{
    "name": "schvoy/user-bundle",
    "description": "User bundle - This bundle provides a basic user entity and user repository.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Norbert Schvoy",
            "email": "norbert.schvoy@eightmarq.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Schvoy\\UserBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Schvoy\\UserBundle\\Tests\\": "tests/" }
    },
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.0",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.2",
        "doctrine/doctrine-bundle": "^3.3",
        "schvoy/base-entity-bundle": "^1.2",
        "symfony/var-exporter": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.1",
        "friendsofphp/php-cs-fixer": "^3.58",
        "symfony/yaml": "^8.0"
    },
    "scripts": {
        "before-commit": [
            "vendor/bin/php-cs-fixer fix src",
            "vendor/bin/php-cs-fixer fix tests",
            "vendor/bin/phpunit"
        ],
        "code-quality": [
            "vendor/bin/php-cs-fixer fix --dry-run src",
            "vendor/bin/php-cs-fixer fix --dry-run tests"
        ],
        "tests": [
            "vendor/bin/phpunit"
        ]
    }
}
